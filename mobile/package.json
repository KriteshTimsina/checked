{
  "name": "checked",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "build": "expo lint && tsc",
    "db:generate": "npx drizzle-kit generate",
    "build:development": "eas build --platform android --profile development",
    "build:preview": "eas build --platform android --profile preview",
    "build:release": "eas build --platform android --profile release",
    "build:production": "eas build --platform android --profile production",
    "cache:clean": "npm cache clean --force",
    "prebuild": "npx expo prebuild",
    "prebuild:android": "npx expo prebuild --clean --platform android",
    "prebuild:ios": "npx expo prebuild --clean --platform ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@gorhom/bottom-sheet": "^5.0.6",
    "@howincodes/expo-dynamic-app-icon": "^3.0.2",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/material-top-tabs": "^7.1.0",
    "@react-navigation/native": "^7.0.14",
    "babel-plugin-inline-import": "^3.0.0",
    "dayjs": "^1.11.13",
    "drizzle-orm": "^0.38.3",
    "expo": "^53.0.27",
    "expo-build-properties": "~0.14.8",
    "expo-checkbox": "~4.1.4",
    "expo-constants": "~17.1.8",
    "expo-dev-client": "~5.2.4",
    "expo-drizzle-studio-plugin": "^0.1.1",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-in-app-updates": "^0.9.0",
    "expo-linking": "~7.1.7",
    "expo-modules-core": "~2.5.0",
    "expo-print": "~14.1.4",
    "expo-router": "~5.1.11",
    "expo-sharing": "~13.1.5",
    "expo-splash-screen": "~0.30.10",
    "expo-sqlite": "~15.2.14",
    "expo-status-bar": "~2.2.3",
    "expo-store-review": "~8.1.5",
    "expo-system-ui": "~5.0.11",
    "expo-web-browser": "~14.2.0",
    "lodash": "^4.17.21",
    "lottie-react-native": "7.2.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-calendars": "^1.1314.0",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-mmkv": "^3.2.0",
    "react-native-pager-view": "6.7.1",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-tab-view": "^4.0.5",
    "react-native-toast-message": "^2.3.3",
    "zustand": "^5.0.3"
  },
  "overrides": {
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-server-dom-webpack": "19.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.17.14",
    "@types/react": "~19.0.10",
    "@types/react-test-renderer": "^18.3.0",
    "drizzle-kit": "^0.30.1",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~9.2.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "react-test-renderer": "18.3.1",
    "typescript": "~5.8.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-confetti-cannon",
          "@howincodes/expo-dynamic-app-icon"
        ]
      }
    }
  },
  "private": true
}
