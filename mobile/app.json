{
  "expo": {
    "name": "Checked",
    "slug": "checklist",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "checked",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "githubUrl": "https://github.com/kriteshtimsina/checked",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kriteshtimsina.checklist",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSExceptionDomains": {
            "localhost": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            },
            "127.0.0.1": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            },
            "192.168.0.0": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/icon-forest-foreground.png",
        "backgroundColor": "#E5F4D9"
      },
      "package": "com.kriteshtimsina.checklist",
      "versionCode": 2,
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.kriteshtimsina.checklist"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FDF8F2",
          "dark": {
            "backgroundColor": "#0F0F11"
          }
        }
      ],
      [
        "@howincodes/expo-dynamic-app-icon",
        {
          "forest": {
            "ios": "./src/assets/images/icon.png",
            "android": {
              "foregroundImage": "./src/assets/images/icon-forest-foreground.png",
              "backgroundColor": "#E5F4D9"
            }
          },
          "sandy": {
            "ios": "./src/assets/images/icon-1.png",
            "android": {
              "foregroundImage": "./src/assets/images/icon-sandy-foreground.png",
              "backgroundColor": "#F0E4D0"
            }
          },
          "tomato": {
            "ios": "./src/assets/images/icon-2.png",
            "android": {
              "foregroundImage": "./src/assets/images/icon-tomato-foreground.png",
              "backgroundColor": "#FFE0E0"
            }
          },
          "lavender": {
            "ios": "./src/assets/images/icon-3.png",
            "android": {
              "foregroundImage": "./src/assets/images/icon-lavender-foreground.png",
              "backgroundColor": "#EDD9FF"
            }
          },
          "origami": {
            "ios": "./src/assets/images/ios-4.png",
            "android": {
              "foregroundImage": "./src/assets/images/icon-origami-foreground.png",
              "backgroundColor": "#FAF3E6"
            }
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "ca9c1110-f505-463a-b8cf-71546edb93c9"
      }
    }
  }
}
